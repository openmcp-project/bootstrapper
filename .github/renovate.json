{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>openmcp-project/.github:renovate-config"
  ],
  "ignorePaths": [
    "**/internal/deployment-repo/testdata/**"
  ],
  "packageRules": [
    {
      "description": "Group fluxcd updates in a single PR",
      "matchDatasources": [
        "go"
      ],
      "groupName": "fluxcd dependencies",
      "groupSlug": "fluxcd-dependencies",
      "matchPackageNames": [
        "/^github\\.com/fluxcd/"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "All component dependencies in other locations.",
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s.+?(_version|_VERSION)( |)=( |)(\"|)(?<currentValue>.+?)(\"|)?\\s"
      ]
    }
  ]
}
